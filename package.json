{
  "name": "hurray-harness",
  "version": "0.2.0",
  "description": "Track every build. Lose fewer hairs. A live, tool-neutral view of AI agent lanes, tickets, worktrees and merges.",
  "keywords": [
    "ai-agents",
    "agent-harness",
    "claude-code",
    "cursor",
    "git-worktree",
    "dashboard",
    "developer-tools",
    "github",
    "tui"
  ],
  "homepage": "https://narasimhaponnada.github.io/hurray-harness/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narasimhaponnada/hurray-harness.git"
  },
  "bugs": {
    "url": "https://github.com/Narasimhaponnada/hurray-harness/issues"
  },
  "author": "Narasimhaponnada",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "hh": "bin/hh.js"
  },
  "files": [
    "bin",
    "dist",
    "integrations",
    "docs/*.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts start --demo",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node bin/hh.js start",
    "demo": "node bin/hh.js start --demo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
