{
  "name": "hurray-harness",
  "version": "0.1.0",
  "description": "Track every build. Lose fewer hairs. A live, tool-neutral view of AI agent lanes, tickets, worktrees and merges.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "hh": "bin/hh.js"
  },
  "files": [
    "bin",
    "dist",
    "integrations",
    "docs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts start --demo",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node bin/hh.js start",
    "demo": "node bin/hh.js start --demo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
