{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "curl -s -m 1 -H 'content-type: application/json' --data-binary @- http://127.0.0.1:7311/api/hook/claude-code >/dev/null 2>&1 || true" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Skill|Agent|Task",
        "hooks": [{ "type": "command", "command": "curl -s -m 1 -H 'content-type: application/json' --data-binary @- http://127.0.0.1:7311/api/hook/claude-code >/dev/null 2>&1 || true" }]
      }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "curl -s -m 1 -H 'content-type: application/json' --data-binary @- http://127.0.0.1:7311/api/hook/claude-code >/dev/null 2>&1 || true" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "curl -s -m 1 -H 'content-type: application/json' --data-binary @- http://127.0.0.1:7311/api/hook/claude-code >/dev/null 2>&1 || true" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "curl -s -m 1 -H 'content-type: application/json' --data-binary @- http://127.0.0.1:7311/api/hook/claude-code >/dev/null 2>&1 || true" }] }
    ]
  }
}
