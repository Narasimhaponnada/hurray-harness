{
  "port": 7311,
  "refreshSeconds": 60,
  "gitFetch": false,
  "keepDays": 14,
  "rotateSeconds": 120,
  "approvalBranches": ["main"],
  "teams": {
    "webhookUrl": "https://<your Teams Workflows webhook URL>",
    "tunnel": true,
    "notify": "all",
    "linkHours": 24
  },
  "labels": {
    "decision": ["needs-human", "needs-decision", "needs-review", "question"],
    "blocked": ["blocked", "status:blocked"],
    "qa": ["qa", "needs-qa", "status:qa"],
    "inProgress": ["in-progress", "status:in-progress", "wip"],
    "ready": ["ready", "status:ready"]
  },
  "repos": [
    { "path": "~/code/my-product", "github": "me/my-product", "base": "origin/main", "milestone": "0.2" }
  ]
}
